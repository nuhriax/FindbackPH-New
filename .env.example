# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only in server actions/route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Omit it in local dev; set it to your production origin when deploying (e.g. https://findback.ph).
NEXT_PUBLIC_SITE_URL=
