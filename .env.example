# Supabase - Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only in server actions/route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Required for password-reset / OAuth callback emails to build correct links.
# Local dev: http://localhost:3000   |   Vercel: your deployed origin (e.g. https://findback-ph.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Google OAuth provider (create a Google Cloud OAuth Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth provider (create a Facebook developer app)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Search Console verification (HTML tag method).
# Paste the content value Google gives you (e.g. google-site-verification=abc123)
# Set in Vercel for Production + commit/push to take effect.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (meta tag method).
# Paste the content value Bing gives you (the "msvalidate.01" content string).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Custom SMTP (Gmail) — used by Supabase to send confirmation / password-reset emails.
# 🔴 IMPORTANT: use port 587 (STARTTLS). Supabase's auth engine (GoTrue via gomail)
# does NOT support Gmail port 465 (implicit TLS), so 465 always fails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>@gmail.com
SMTP_PASSWORD=

# Cloudflare Turnstile (optional bot protection). When both keys are set, the
# signup / contact / report-creation server actions verify the challenge
# server-side via src/lib/actions/turnstile.ts. With these unset, the actions
# are no-ops and the app keeps working, so this is safe to leave blank locally.
# Create a site at https://dash.cloudflare.com/turnstile and copy both keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error monitoring (free tier: 5k errors/month at sentry.io).
# The app runs fine without these — Sentry init is a no-op until the DSN is set.
# NEXT_PUBLIC_SENTRY_DSN is public by design (browser SDK); set it in Vercel for
# Production + Preview to start receiving error reports.
NEXT_PUBLIC_SENTRY_DSN=
# Optional one-time verification token: while set in Vercel, visiting
# /api/sentry-test?token=<value> sends a deliberate test error to Sentry.
# Remove it after verifying.
SENTRY_TEST_TOKEN=

# Contact-form email notifications (server-side, via nodemailer + the SMTP_*
# credentials above). When set, every contact form submission sends an alert
# to this address; otherwise it defaults to SMTP_USER. On Vercel, also add
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD for this to work.
CONTACT_NOTIFY_EMAIL=
